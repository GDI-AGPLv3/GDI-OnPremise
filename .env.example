# ============================================================
# GDI OnPremise — Configuración
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
# Las claves internas las podés generar con: ./scripts/generar-claves.sh
# ============================================================

# --- SISTEMA ---
# Modo de licencia. En on-premise DEBE ser "onpremise": habilita el wizard "crear instancia"
# del BackOffice y hace que los buckets se creen en MinIO (no en Cloudflare). NO lo cambies.
LICENSE_MODE=onpremise

# Versión del SET de imágenes pre-buildeadas del tier pago (ghcr.io). El tier libre buildea local.
# Formato AAAA.MM: es la MISMA para las 3 imágenes. Te la indica GDI en el mail de entrega
# y en cada aviso de actualización. Una versión inexistente hace fallar el arranque
# con "manifest unknown".
IMAGE_VERSION=2026.08

# --- BASE DE DATOS (no cambiar host/port si usás el postgres del compose) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR-password-segura
DB_NAME=railway

# --- AUTH0 (crear tenant en auth0.com — ver guía sección 2) ---
AUTH0_DOMAIN=tu-tenant.us.auth0.com
# AUTH0_AUDIENCE = el Identifier (URI) que VOS inventás al crear la API en Auth0.
# NO es una URL real de Auth0. Debe coincidir EXACTAMENTE con lo que pusiste en Auth0 -> APIs.
AUTH0_AUDIENCE=https://gdi-api
# Opcional: si usás un custom domain de Auth0 (auth.tu-municipio.gob.ar), listá acá
# los issuers válidos separados por coma. Si no, dejalo vacío.
# AUTH0_ISSUERS=
# App del Frontend (portal de usuarios)
AUTH0_FRONTEND_CLIENT_ID=
AUTH0_FRONTEND_CLIENT_SECRET=
# App del BackOffice (solo tier Premium) — descomentar si tenés licencia.
# AUTH0_BACKOFFICE_CLIENT_ID hace que el botón del mail de invitación a
# administradores aterrice en el BackOffice y no en el portal de usuarios.
# AUTH0_BACKOFFICE_CLIENT_ID=
# AUTH0_BACKOFFICE_CLIENT_SECRET=

# --- AUTH0 MACHINE TO MACHINE (OBLIGATORIO para dar de alta usuarios) ---
# Sin estas dos variables el BackOffice NO PUEDE CREAR NINGÚN USUARIO: crear un
# empleado devuelve "Sistema de autenticación no disponible".
# Se crea en Auth0 -> Applications -> Create Application -> Machine to Machine,
# autorizada contra la "Auth0 Management API" con los permisos de usuarios
# (create:users, read:users, update:users, create:user_tickets).
# Ver la guía, sección 2. El BackOffice avisa al arrancar si falta alguna.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- ALMACENAMIENTO (elegir R2 o MinIO — ver guía sección 3) ---
# Cada municipio crea SUS PROPIOS buckets (gdi-<sigla>-oficial / -tosign) al darse de
# alta desde el wizard del BackOffice. Las variables CF_R2_BUCKET_* de abajo son solo un
# fallback por defecto; no hace falta tocarlas.
#
# Opción A (por defecto): MinIO local — es la que usa el manual y la que levanta el paso 7.
# La MISMA password va en las dos variables: MinIO la usa como su root, y el resto del
# sistema como credencial S3.
CF_R2_ENDPOINT=http://minio:9000
CF_R2_ACCESS_KEY_ID=minioadmin
CF_R2_SECRET_ACCESS_KEY=CAMBIAR-minio-password
CF_R2_BUCKET_OFICIAL=gdi-oficial
CF_R2_BUCKET_TOSIGN=gdi-tosign
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIAR-minio-password
# Con MinIO hay que forzar path-style en el cliente S3 (si no, el DNS no resuelve el bucket).
S3_FORCE_PATH_STYLE=true

# Opción B: Cloudflare R2 (nube). Si la usás, comentá el bloque de arriba y descomentá este.
# CF_R2_ENDPOINT=https://TU-ACCOUNT-ID.r2.cloudflarestorage.com
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_BUCKET_OFICIAL=gdi-oficial
# CF_R2_BUCKET_TOSIGN=gdi-tosign
# S3_FORCE_PATH_STYLE=false

# --- EMAIL (opcional — dejar todo vacío para no mandar emails) ---
# Si ponés RESEND_API_KEY usa Resend; si no, y ponés SMTP_HOST, usa SMTP; si nada, no manda.
# Lo normal en un municipio es el SMTP institucional propio (Resend es un servicio
# externo que requiere cuenta y dominio verificado).
# SIN correo el sistema igual funciona: al dar de alta un usuario, el BackOffice
# muestra en pantalla el enlace de activación para entregarlo por otro medio.
# FROM_EMAIL es OBLIGATORIO si configurás correo (no hay remitente por defecto).
# RESEND_API_KEY=
# FROM_EMAIL=GDI <noreply@tu-municipio.gob.ar>
# ALERT_TO_EMAIL=alertas@tu-municipio.gob.ar
# SMTP_HOST=mail.tu-municipio.gob.ar
# SMTP_PORT=587
# SMTP_USER=noreply@tu-municipio.gob.ar
# SMTP_PASSWORD=
# SMTP_FROM=GDI <noreply@tu-municipio.gob.ar>
# SMTP_TLS=true          # STARTTLS (puerto 587)
# SMTP_SSL=false         # SSL implícito (puerto 465). Para puerto 25 sin TLS: ambos false.

# --- FRONTEND (URLs públicas que sirve nginx-proxy-manager por HTTPS) ---
FRONTEND_URL=https://gdi.tu-municipio.gob.ar
NEXT_PUBLIC_API_URL=https://api.tu-municipio.gob.ar

# --- SEGURIDAD (generar con: ./scripts/generar-claves.sh  o  openssl rand -hex 32) ---
# Las mismas 4 claves se reusan entre los servicios que se autentican entre sí.
INTERNAL_API_KEY=CAMBIAR-generar-con-openssl
PDFCOMPOSER_API_KEY=CAMBIAR-generar-con-openssl
NOTARY_API_KEY=CAMBIAR-generar-con-openssl
AUTH0_SECRET=CAMBIAR-generar-con-openssl
# Secret del MCP Gateway (si se omite, usa INTERNAL_API_KEY)
# AGENT_GATEWAY_SECRET=

# --- MÓDULOS PAGOS (tier Premium con licencia) ---
# Si instalás el tier Premium (el que documenta docs/MANUAL.md), estos valores son
# OBLIGATORIOS. Dejarlos vacíos no da un error claro: el BackOffice levanta a medias.
# Si instalás el tier libre, comentá este bloque entero.
# La licencia NO va acá: es el archivo .lic montado como volumen (ver manual, paso 6).
GDI_LICENSE_HOST_DIR=./license
BACKOFFICE_URL=https://admin.tu-municipio.gob.ar          # UI del backoffice
BACKOFFICE_API_URL=https://admin-api.tu-municipio.gob.ar  # API del backoffice-back
AUTH0_BACKOFFICE_CLIENT_ID=
AUTH0_BACKOFFICE_CLIENT_SECRET=
OPENROUTER_API_KEY=sk-or-xxx                              # para AgenteLANG
AGENTELANG_MODEL=openai/gpt-4.1-nano                      # modelo IA (default si se omite)
# GDI_LICENSE_HEARTBEAT_URL=https://license.gdilatam.com/api/heartbeat    # phone-home opcional
